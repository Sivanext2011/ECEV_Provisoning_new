# ECEV Provisioning Tool - Environment Variables
# Copy this to .env and fill in your values

# Path to config file (defaults to ./config/config.json)
CONFIG_PATH=./config/config.json

# Logging level
LOG_LEVEL=INFO

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS origins (comma-separated, use * for dev only)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Override auth credentials via env (takes precedence over config.json)
# BSSF_USERNAME=
# BSSF_PASSWORD=
# BSSF_CLIENT_ID=AuthorizationClient
# BSSF_TOKEN_ENDPOINT=
